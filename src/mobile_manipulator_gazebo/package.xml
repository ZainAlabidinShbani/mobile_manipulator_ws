<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mobile_manipulator_gazebo</name>
  <version>0.0.0</version>
  <description>
    Gazebo simulation package for the mobile manipulator.
    Holds the warehouse .world file, Gazebo spawn launch file, and
    ros2_control Gazebo plugin configuration. Populated in Phase 4.
  </description>
  <maintainer email="zain.alabidin.shbani@gmail.com">zsh</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Gazebo Fortress via ros_gz (Gazebo Classic reached EOL Jan 2025).
       ros_gz_sim   — gz_sim.launch.py + the `create` spawn executable
       ros_gz_bridge — gz<->ROS topic bridge (/clock, camera, lidar, pose)
       gz_ros2_control — controller_manager hosted inside gz-sim
       ros_gz_image is deliberately NOT declared: its image_bridge derives
       ROS topic names from the gz ones, whereas the YAML-configured
       ros_gz_bridge pins ros_topic_name explicitly, which is what keeps
       /camera/color/image_raw byte-identical for the perception node. -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>mobile_manipulator_description</exec_depend>

  <!-- Phase 9: warehouse_demo.launch.py is the master launch, so it depends
       on every subsystem it brings up, plus rviz2 and the moveit config
       package whose MoveItConfigsBuilder it calls at launch-description
       construction time. -->
  <exec_depend>mobile_manipulator_navigation</exec_depend>
  <exec_depend>mobile_manipulator_moveit_config</exec_depend>
  <exec_depend>mobile_manipulator_perception</exec_depend>
  <exec_depend>mobile_manipulator_orchestrator</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>nav2_rviz_plugins</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
