    <!-- ════════════════════════════════════════════════════════════════
         PHASE-4 SCREENSHOT CAMERA  (world-fixed, native gz-sim camera)
         Third-person view of the robot at its home pose, used to capture
         the Phase-4 stability screenshot headlessly (without gzclient).

         Publishes /phase4_camera/image_raw + /phase4_camera/camera_info
         once ros_gz_bridge carries them over; the gz-side names come from
         <topic> below (gz appends /camera_info to it).  Under Classic this
         was driven by the plugin's <camera_name>; there is no plugin now.
         NOTE: <horizontal_fov>/<image>/<clip> MUST sit inside <camera>;
         as direct <sensor> children they are dropped and the sensor falls
         back to the SDF default 320x240 camera.

         Pose: eye (-2.4, -2.4, 1.35) aimed at (0, 0, 0.45).  The -X/-Y
         quadrant is the only approach to the origin that the jersey
         barriers (x=1.6, y=+-4.6) do not block.  The downward tilt is
         PITCH, not roll: view dir = (cosY cosP, sinY cosP, -sinP).
         ════════════════════════════════════════════════════════════════ -->
    <!-- ════════════════════════════════════════════════════════════════
         DEMO CAMERA — world-fixed wide view of BOTH benches.

         Added for the Phase 9 evidence recording.  The full demo has to run
         with gui:=false (the gz GUI starves the wrist cameras and drags the
         real-time factor from ~0.9 to ~0.45 on this box), so there is no
         window to screen-record; and phase4_camera looks at the home pose,
         not at the benches.  This camera sees the pick bench at (4.5, 0) and
         the drop bench at (4.5, 3.2) in one frame, so the object can be
         watched moving from one to the other without a GUI.

         Visual only: static, no collision, and mounted at z = 3.0 — well
         above the 0.30 m lidar plane, so it is invisible to SLAM, AMCL and
         both costmaps and cannot perturb any earlier phase's gate.
         ════════════════════════════════════════════════════════════════ -->
    <model name="demo_camera">
      <static>true</static>
      <pose>0.5 1.6 3.0 0 0.54 0</pose>
      <link name="link">
        <sensor name="demo_camera" type="camera">
          <update_rate>10</update_rate>
          <always_on>1</always_on>
          <topic>demo_camera/image_raw</topic>
          <ignition_frame_id>demo_camera_link</ignition_frame_id>
          <camera>
            <horizontal_fov>1.4</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <model name="phase4_camera">
      <static>true</static>
      <link name="phase4_camera_link">
        <sensor name="phase4_camera_sensor" type="camera">
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <topic>phase4_camera/image_raw</topic>
          <ignition_frame_id>phase4_camera_link</ignition_frame_id>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>100.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
      <pose>-2.4 -2.4 1.35 0 0.25921 0.7854</pose>
    </model>

  </world>
</sdf>