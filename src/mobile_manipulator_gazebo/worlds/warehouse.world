            </sphere>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <pose>3.92 0.26 0.6330 0 0 0</pose>
    </model>

    <model name="target_ball_green">
      <static>false</static>
      <link name="body">
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.0000871</ixx>
