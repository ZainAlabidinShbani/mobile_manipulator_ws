            <diffuse>0 1 0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <pose>3.92 0.00 0.6330 0 0 0</pose>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         HOME-POSE MARKER  (visual only, under the robot at spawn)
