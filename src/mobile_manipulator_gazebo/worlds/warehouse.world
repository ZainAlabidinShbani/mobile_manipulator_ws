<?xml version="1.0"?>
<!--
  warehouse.world
  ─────────────────────────────────────────────────────────────────────────────
  Phase 4 — Gazebo Fortress (gz-sim 6) warehouse floor plan for the mobile
  manipulator.  Migrated from Gazebo Classic, which reached EOL in Jan 2025.

  Phase 4 rework: rack rows densified to 5 bays, cargo pallets + cardboard
  stock inside the aisles, construction barrels / cabinets / brick cargo
  blocks shaping the drivable rooms and giving AMCL asymmetric landmarks.
  All clutter keeps >= 1.0 m clearance from the Phase 6 routes; sub-0.30 m
  obstacles (pallets, cardboard, cones) sit only where the robot never
  drives, because the 2D lidar scan plane cannot see them.

  All furniture (storage racks, wooden pallets, barrier obstacles) is composed
  from existing Gazebo model-database models (osrf/gazebo_models, installed
  under ~/.gazebo/models and referenced via model://; the launch file puts
  that directory on IGN_GAZEBO_RESOURCE_PATH, which replaced
  GAZEBO_MODEL_PATH).  Those vendored models still carry Ogre <script>
  materials, which Fortress cannot render, so they appear untextured —
  geometry and collisions, which is all Nav2 and the costmaps consume,
  are unaffected.  No mesh geometry is
  hand-authored in this file — the only primitive geometry is the warehouse
  slab, perimeter walls, the home-pose marker, and the pick/drop target
  objects (red / blue / green 75 mm spheres, COCO class "sports ball" —
  see the TARGET OBJECTS block for why spheres and not cubes).

  Floor plan:
    - Warehouse slab 36 x 28 m, top surface at z = 0.
    - Two storage-rack aisles: 4 rows x 3 bookshelf racks (model://bookshelf)
        aisle 1 between x = -11 and x = -8
        aisle 2 between x =  8  and x = 11
    - 8 wooden pallets (model://euro_pallet) at aisle ends and side lanes.
    - 4 jersey barriers (model://jersey_barrier) flanking the central
      drive lane and dividing the main aisle from the outer lanes.
    - Pick-up workbench (model://table) at (4.5, 0), drop-off table at
      (4.5, 3.2).  Three target objects sit on the pick workbench.
    - Home pose marker (visual only) at the robot spawn point (0, 0).
    - Lighting: two directional lights (key + fill) and two point lights
      over the tables, with moderate intensities + ambient so the RGB
      camera feed is neither blown out nor too dark.
  ─────────────────────────────────────────────────────────────────────────────
-->
<sdf version="1.7">
  <world name="warehouse">

    <!-- ════════════════════════════════════════════════════════════════
         GZ-SIM SYSTEM PLUGINS
         Gazebo Classic had these behaviours built into gzserver.  Under
         Fortress every one of them is an explicitly loaded system:
           Physics         — steps the world at all
           UserCommands    — serves /world/warehouse/create, which is how
                             `ros_gz_sim create` spawns the robot
           SceneBroadcaster— publishes scene + pose state (the GUI, and
                             the pose_info topic used for ground truth)
           Sensors         — renders cameras and lidar.  NOT loaded by
                             default: without it every sensor stays silent
                             while the sim otherwise looks healthy.
         ════════════════════════════════════════════════════════════════ -->
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ════════════════════════════════════════════════════════════════
         SCENE + LIGHTING  (tuned for the wrist RGB camera: no blown-out
         highlights, no crushed shadows; mean frame luminance ~0.5–0.7)
         ════════════════════════════════════════════════════════════════ -->
    <scene>
      <ambient>0.50 0.50 0.50 1.0</ambient>
      <background>0.32 0.36 0.42 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- Key light: warm white, high angle, casts shadows -->
    <light type="directional" name="warehouse_key_light">
      <pose>0 0 18 0 0 0</pose>
      <diffuse>0.80 0.80 0.78 1.0</diffuse>
      <specular>0.10 0.10 0.10 1.0</specular>
      <direction>-0.30 0.20 -1.0</direction>
      <cast_shadows>true</cast_shadows>
      <intensity>0.80</intensity>
    </light>

    <!-- Fill light: cooler, low intensity, opposite angle -->
    <light type="directional" name="warehouse_fill_light">
      <pose>12 -10 14 0 0 0</pose>
      <diffuse>0.45 0.45 0.50 1.0</diffuse>
      <specular>0.05 0.05 0.05 1.0</specular>
      <direction>-0.55 0.45 -1.0</direction>
      <intensity>0.40</intensity>
    </light>

    <!-- Point light over the pick-up workbench -->
    <light type="point" name="pick_workbench_light">
      <pose>4.5 0.0 3.4 0 0 0</pose>
      <diffuse>0.90 0.90 0.85 1.0</diffuse>
      <specular>0.20 0.20 0.20 1.0</specular>
      <attenuation>0.0 0.55 0.08</attenuation>
      <intensity>0.90</intensity>
    </light>

    <!-- Point light over the drop-off table -->
    <light type="point" name="drop_off_table_light">
      <pose>4.5 3.2 3.4 0 0 0</pose>
      <diffuse>0.90 0.90 0.85 1.0</diffuse>
      <specular>0.20 0.20 0.20 1.0</specular>
      <attenuation>0.0 0.55 0.08</attenuation>
      <intensity>0.90</intensity>
    </light>

    <!-- ════════════════════════════════════════════════════════════════
         PHYSICS  (1000 Hz ODE; real-time factor target ≥ 0.7)
         ════════════════════════════════════════════════════════════════ -->
    <!-- Fortress ignores type="ode" (it runs DART via the Physics system)
         and ignores real_time_update_rate; the effective step rate is
         real_time_factor / max_step_size = 500 Hz, which is what the
         Classic pair of values already meant.  Kept verbatim so the
         intent stays readable and Classic can still load this file. -->
    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <!-- ════════════════════════════════════════════════════════════════
         WAREHOUSE SHELL  (primitive geometry: slab + perimeter walls)
         ════════════════════════════════════════════════════════════════ -->
    <model name="warehouse_slab">
      <static>true</static>
      <pose>0 0 -0.15 0 0 0</pose>
      <link name="slab">
        <collision name="slab_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>36.0 28.0 0.3</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.9</mu>
                <mu2>0.9</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="slab_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>36.0 28.0 0.3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="north_wall">
      <static>true</static>
      <link name="wall">
        <collision name="collision">
          <geometry><box><size>36.0 0.3 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>36.0 0.3 2.5</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <pose>0 -14.2 1.25 0 0 0</pose>
    </model>

    <model name="south_wall">
      <static>true</static>
      <link name="wall">
        <collision name="collision">
          <geometry><box><size>36.0 0.3 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>36.0 0.3 2.5</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <pose>0 14.2 1.25 0 0 0</pose>
    </model>

    <model name="west_wall">
      <static>true</static>
      <link name="wall">
        <collision name="collision">
          <geometry><box><size>0.3 29.0 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 29.0 2.5</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <pose>-18.15 0 1.25 0 0 0</pose>
    </model>

    <model name="east_wall">
      <static>true</static>
      <link name="wall">
        <collision name="collision">
          <geometry><box><size>0.3 29.0 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 29.0 2.5</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <pose>18.15 0 1.25 0 0 0</pose>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         STORAGE-RACK AISLES  (model://bookshelf, static)
         Row layout: 4 rows x 3 racks; racks run along Y (yaw 90°).
         Aisle 1: x = -11 / -8      Aisle 2: x = 8 / 11
         ════════════════════════════════════════════════════════════════ -->
    <include><uri>model://bookshelf</uri><name>rack_a1_yneg</name><pose>-11 -6 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://bookshelf</uri><name>rack_a1_ymid</name><pose>-11 0 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://bookshelf</uri><name>rack_a1_ypos</name><pose>-11 6 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://bookshelf</uri><name>rack_a2_yneg</name><pose>-8 -6 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://bookshelf</uri><name>rack_a2_ymid</name><pose>-8 0 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://bookshelf</uri><name>rack_a2_ypos</name><pose>-8 6 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://bookshelf</uri><name>rack_b1_yneg</name><pose>8 -6 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://bookshelf</uri><name>rack_b1_ymid</name><pose>8 0 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://bookshelf</uri><name>rack_b1_ypos</name><pose>8 6 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://bookshelf</uri><name>rack_b2_yneg</name><pose>11 -6 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://bookshelf</uri><name>rack_b2_ymid</name><pose>11 0 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://bookshelf</uri><name>rack_b2_ypos</name><pose>11 6 0 0 0 1.5708</pose><static>true</static></include>

    <!-- ════════════════════════════════════════════════════════════════
         WOODEN PALLETS  (model://euro_pallet, static)
         At the end of each aisle plus along the outer side lanes.
         ════════════════════════════════════════════════════════════════ -->
    <include><uri>model://euro_pallet</uri><name>pallet_aisle1_neg</name><pose>-9.5 -8.6 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://euro_pallet</uri><name>pallet_aisle1_pos</name><pose>-9.5 8.6 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://euro_pallet</uri><name>pallet_aisle2_neg</name><pose>9.5 -8.6 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://euro_pallet</uri><name>pallet_aisle2_pos</name><pose>9.5 8.6 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://euro_pallet</uri><name>pallet_north</name><pose>0 -10.6 0 0 0 0.35</pose><static>true</static></include>
    <include><uri>model://euro_pallet</uri><name>pallet_south</name><pose>0 10.6 0 0 0 -0.35</pose><static>true</static></include>
    <include><uri>model://euro_pallet</uri><name>pallet_west</name><pose>-14.0 0 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://euro_pallet</uri><name>pallet_east</name><pose>14.0 0 0 0 0 1.5708</pose><static>true</static></include>

    <!-- ════════════════════════════════════════════════════════════════
         BARRIER OBSTACLES  (model://jersey_barrier, static)
         Two flank the central drive lane to the workbench (at x = 1.6,
         oriented along Y); two divide the main aisle from the outer lanes.
         ════════════════════════════════════════════════════════════════ -->
    <include><uri>model://jersey_barrier</uri><name>barrier_lane_north</name><pose>1.6 2.5 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://jersey_barrier</uri><name>barrier_lane_south</name><pose>1.6 -2.5 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://jersey_barrier</uri><name>barrier_aisle_north</name><pose>0 4.6 0 0 0 0.0</pose><static>true</static></include>
    <include><uri>model://jersey_barrier</uri><name>barrier_aisle_south</name><pose>0 -4.6 0 0 0 0.0</pose><static>true</static></include>

    <!-- ════════════════════════════════════════════════════════════════
         DENSE STORAGE + CLUTTER  (phase4 rework: harder, busier floor)
         Every model here is static and placed >= 1.0 m clear of both the
         Phase 6 demo route (home -> barrier gate -> workbench) and the
         mapping loop (west -3.0 / north 6.5 / east 6.2 lines).  Anything
         shorter than the 0.30 m lidar scan plane (pallets, cardboard,
         cones) stays deep inside rack aisles or far corners — the 2D
         lidar cannot see it, so it must never sit on a drivable route.
         ════════════════════════════════════════════════════════════════ -->

    <!-- Rack rows densified: 5 bookshelves per row (added y = -3, +3) -->
    <include><uri>model://bookshelf</uri><name>rack_a1_ynhalf</name><pose>-11 -3 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://bookshelf</uri><name>rack_a1_yphalf</name><pose>-11 3 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://bookshelf</uri><name>rack_a2_ynhalf</name><pose>-8 -3 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://bookshelf</uri><name>rack_a2_yphalf</name><pose>-8 3 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://bookshelf</uri><name>rack_b1_ynhalf</name><pose>8 -3 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://bookshelf</uri><name>rack_b1_yphalf</name><pose>8 3 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://bookshelf</uri><name>rack_b2_ynhalf</name><pose>11 -3 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://bookshelf</uri><name>rack_b2_yphalf</name><pose>11 3 0 0 0 1.5708</pose><static>true</static></include>

    <!-- Cargo pallets inside the rack aisles, cardboard stock on top -->
    <include><uri>model://euro_pallet</uri><name>pallet_aisle1_mid</name><pose>-9.5 3.0 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://euro_pallet</uri><name>pallet_aisle2_mid</name><pose>9.5 -3.0 0 0 0 1.5708</pose><static>true</static></include>
    <include><uri>model://cardboard_box</uri><name>cargo_box_aisle1</name><pose>-9.5 3.0 0.15 0 0 0.2</pose><static>true</static></include>
    <include><uri>model://cardboard_box</uri><name>cargo_box_aisle2</name><pose>9.5 -3.0 0.15 0 0 -0.35</pose><static>true</static></include>

    <!-- West room shaping: barrels + a cabinet landmark near the -3,0 turn -->
    <include><uri>model://construction_barrel</uri><name>barrel_west_north</name><pose>-1.7 1.7 0 0 0 0</pose><static>true</static></include>
    <include><uri>model://construction_barrel</uri><name>barrel_west_south</name><pose>-0.6 -2.6 0 0 0 0</pose><static>true</static></include>
    <include><uri>model://cabinet</uri><name>cabinet_home_west</name><pose>-3.9 -1.2 0 0 0 0.3</pose><static>true</static></include>

    <!-- North corridor structure + big cargo block landmark -->
    <include><uri>model://jersey_barrier</uri><name>barrier_north_zone</name><pose>1.5 8.6 0 0 0 0.25</pose><static>true</static></include>
    <include><uri>model://brick_box_3x1x3</uri><name>cargo_block_north</name><pose>-5.5 9.0 0 0 0 0.15</pose><static>true</static></include>

    <!-- East approach: barrel + cabinet, unique signature near the goal -->
    <include><uri>model://construction_barrel</uri><name>barrel_east_north</name><pose>4.9 5.1 0 0 0 0</pose><static>true</static></include>
    <include><uri>model://cabinet</uri><name>cabinet_east</name><pose>7.6 1.8 0 0 0 -0.4</pose><static>true</static></include>

    <!-- South zone: asymmetric landmarks (AMCL disambiguation) + decor -->
    <include><uri>model://brick_box_3x1x3</uri><name>cargo_block_south</name><pose>3.0 -8.8 0 0 0 1.35</pose><static>true</static></include>
    <include><uri>model://construction_barrel</uri><name>barrel_south</name><pose>1.0 -6.2 0 0 0 0</pose><static>true</static></include>
    <include><uri>model://construction_cone</uri><name>cone_sw</name><pose>-5.0 -4.5 0 0 0 0</pose><static>true</static></include>
    <include><uri>model://construction_cone</uri><name>cone_nw</name><pose>-5.5 4.0 0 0 0 0</pose><static>true</static></include>
    <include><uri>model://construction_cone</uri><name>cone_se</name><pose>5.5 -5.5 0 0 0 0</pose><static>true</static></include>

    <!-- ════════════════════════════════════════════════════════════════
         PICK-UP WORKBENCH + DROP-OFF TABLE

         Hand-authored in Phase 9, replacing <include>model://table</include>.
         Two changes, both forced by measurement rather than taste:

         HEIGHT 1.015 m -> 0.600 m.  The vendored table put its surface at
         1.015 m, and the UR5 cannot reach a target standing on it.  The base
         parks with base_footprint at x = 3.24 (its lidar puck protrudes to
         x = +0.575 and the near table legs are at x = 3.82), the arm shoulder
         sits at base_footprint (0.0812, 0, 0.4844), and a top-down grasp needs
         the tool0 frame 0.115 m above the object.  /compute_ik over the
         ur5_arm group returns NO_IK_SOLUTION (-31) for every object standing
         further than 0.45 m in front of the base at z = 1.0525, and the object
         is 1.01 m away.  At a 0.60 m surface the same query solves out to
         0.85 m, which covers the whole 0.25 m Nav2 goal tolerance.  This is
         the Phase 9 root cause, isolated before anything else was touched.

         MATERIAL Ogre script -> PBR.  model://table carries an Ogre
         <material><script> that Fortress does not implement, so it rendered
         black and dragged the whole scene's exposure down with it — Phase 7
         measured target confidence falling from 0.67-0.89 to 0.35.

         The 1.5 x 0.8 top and the four r = 0.02 legs at (+/-0.68, +/-0.38)
         are copied from model://table verbatim, so the silhouette the 0.30 m
         lidar plane sees is unchanged and maps/warehouse.pgm stays valid.
         ════════════════════════════════════════════════════════════════ -->
    <model name="pick_workbench">
      <static>true</static>
      <pose>4.5 0 0 0 0 0</pose>
      <link name="link">
        <collision name="surface">
          <pose>0 0 0.585 0 0 0</pose>
          <geometry><box><size>1.5 0.8 0.03</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="surface_visual">
          <pose>0 0 0.585 0 0 0</pose>
          <geometry><box><size>1.5 0.8 0.03</size></box></geometry>
          <material>
            <ambient>0.42 0.31 0.19 1</ambient>
            <diffuse>0.72 0.55 0.34 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>
        <collision name="front_left_leg">
          <pose>0.68 0.38 0.285 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.57</length></cylinder></geometry>
        </collision>
        <visual name="front_left_leg_visual">
          <pose>0.68 0.38 0.285 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.57</length></cylinder></geometry>
          <material>
            <ambient>0.22 0.22 0.24 1</ambient>
            <diffuse>0.45 0.46 0.50 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
          </material>
        </visual>
        <collision name="front_right_leg">
          <pose>0.68 -0.38 0.285 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.57</length></cylinder></geometry>
        </collision>
        <visual name="front_right_leg_visual">
          <pose>0.68 -0.38 0.285 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.57</length></cylinder></geometry>
          <material>
            <ambient>0.22 0.22 0.24 1</ambient>
            <diffuse>0.45 0.46 0.50 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
          </material>
        </visual>
        <collision name="back_left_leg">
          <pose>-0.68 0.38 0.285 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.57</length></cylinder></geometry>
        </collision>
        <visual name="back_left_leg_visual">
          <pose>-0.68 0.38 0.285 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.57</length></cylinder></geometry>
          <material>
            <ambient>0.22 0.22 0.24 1</ambient>
            <diffuse>0.45 0.46 0.50 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
          </material>
        </visual>
        <collision name="back_right_leg">
          <pose>-0.68 -0.38 0.285 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.57</length></cylinder></geometry>
        </collision>
        <visual name="back_right_leg_visual">
          <pose>-0.68 -0.38 0.285 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.57</length></cylinder></geometry>
          <material>
            <ambient>0.22 0.22 0.24 1</ambient>
            <diffuse>0.45 0.46 0.50 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="drop_off_table">
      <static>true</static>
      <pose>4.5 3.2 0 0 0 0</pose>
      <link name="link">
