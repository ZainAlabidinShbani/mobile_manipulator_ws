<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mobile_manipulator_perception</name>
  <version>0.0.0</version>
  <description>
    YOLOv8 perception node for the mobile manipulator.
    Subscribes to the RealSense D435i RGB+depth streams, runs Ultralytics
    YOLOv8 inference on synchronised frame pairs, and broadcasts an
    object_target_frame TF for the orchestrator.
  </description>
  <maintainer email="zain.alabidin.shbani@gmail.com">zsh</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>message_filters</depend>
  <depend>ament_index_python</depend>
  <exec_depend>python3-numpy</exec_depend>

  <!-- phase7_look_pose drives the arm to the tabletop-viewing configuration -->
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>

  <!-- Ultralytics and its OpenCV build come from pip, not rosdep, and are
       installed by the preflight step in PLAN.md section 2:
         pip install ultralytics opencv-python
       cv_bridge is deliberately NOT a dependency: its Humble boost extension
       is built against numpy 1.x and breaks under the numpy 2.x that
       Ultralytics/torch require, so the node decodes Image messages itself. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
  <!-- Phase 10: launch_testing integration test (test/test_perception_tf.py).
       Declared here, not as tests_require in setup.py, which colcon ignores. -->
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>tf2_ros</test_depend>
  <!-- NOT a <test_depend>mobile_manipulator_gazebo</test_depend>, even though
       test_perception_tf.py includes that package's launch file: gazebo
       already exec_depends on this package (warehouse_demo.launch.py starts
       the detector), so declaring it here makes the dependency graph circular
       and colcon refuses to build.  The test resolves the launch file through
       the ament index at run time instead. -->
</package>
