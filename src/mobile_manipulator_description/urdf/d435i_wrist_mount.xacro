<?xml version="1.0"?>
<!--
  d435i_wrist_mount.xacro
  Camera mount macro: attaches a RealSense D435i to the UR5 tool0 link
  via a small wrist bracket. Publishes camera_link and camera_color_optical_frame
  per REP-103 (x-forward in camera body frame, optical frame x-right y-down z-forward).
  The realsense2_description sensor_d435i macro handles all optical-frame joints.
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- Include the RealSense D435i macro from the vendor package -->
  <xacro:include filename="$(find realsense2_description)/urdf/_d435i.urdf.xacro"/>

  <!--
    xacro:macro  d435i_wrist_mount
    Inserts a wrist bracket link between the UR5 tool0 and the D435i camera.

    Parameters
      parent          : tool0 link of the UR5 arm (typically "${arm_prefix}tool0")
      camera_name     : base name for all camera frames (default: "camera")
                        → produces camera_link, camera_color_optical_frame, etc.
      xyz             : bracket position relative to parent (default: 0.05 m forward, 0.04 m up)
      rpy             : bracket orientation relative to parent (default: tilted -30° about Y = camera faces forward-down)
  -->
  <xacro:macro name="d435i_wrist_mount"
               params="parent
                       camera_name:='camera'
                       xyz:='0.05 0.0 0.04'
                       rpy:='0.0 -0.5236 0.0'">

    <!-- Wrist bracket link: small L-shaped aluminium bracket -->
    <link name="${camera_name}_bracket_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
        <geometry>
          <box size="0.06 0.04 0.04"/>
        </geometry>
        <material name="camera_bracket_dark">
          <color rgba="0.15 0.15 0.15 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
        <geometry>
          <box size="0.06 0.04 0.04"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0000167" ixy="0.0" ixz="0.0"
                 iyy="0.0000267" iyz="0.0"
                 izz="0.0000167"/>
      </inertial>
    </link>

    <!-- Joint: tool0 → camera_bracket_link -->
    <joint name="${camera_name}_bracket_joint" type="fixed">
      <parent link="${parent}"/>
      <child  link="${camera_name}_bracket_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!--
      D435i macro from realsense2_description.
      parent is our bracket; sensor will publish:
        ${camera_name}_bottom_screw_frame
        ${camera_name}_link         ← "camera_link"
        ${camera_name}_depth_frame / _depth_optical_frame
        ${camera_name}_color_frame  / _color_optical_frame  ← "camera_color_optical_frame"
        ${camera_name}_infra1_frame / _infra2_frame (and optical versions)
      All optical frames use REP-103 convention (x-right, y-down, z-forward).
    -->
    <xacro:sensor_d435i
        parent="${camera_name}_bracket_link"
        name="${camera_name}"
        use_nominal_extrinsics="true">
      <!-- Place camera flush at bracket front face, lens forward -->
      <origin xyz="0.03 0.0 0.0" rpy="0 0 0"/>
    </xacro:sensor_d435i>

  </xacro:macro>

</robot>
