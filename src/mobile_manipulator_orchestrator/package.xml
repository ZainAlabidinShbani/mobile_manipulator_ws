<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mobile_manipulator_orchestrator</name>
  <version>0.0.0</version>
  <description>
    State-machine orchestrator for the mobile manipulator warehouse demo.
    Implements the HOME→NAV_TO_PICK→PERCEIVE→APPROACH_ARM→GRASP→
    NAV_TO_DROP→PLACE_ARM→RELEASE→RETURN_HOME cycle, calling Nav2,
    MoveIt2, and the gripper controller. Populated in Phase 8.
  </description>
  <maintainer email="zain.alabidin.shbani@gmail.com">zsh</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>action_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>moveit_msgs</depend>
  <depend>control_msgs</depend>
  <depend>shape_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
